# BEGIN TheGenies — managed by TheGenies/deploy.sh (do not edit by hand)
    # Pretty path: https://themithrilcompany.com/genies/
    # Flat URL /genies.html is served by TheUSDX (Flask) like rifts.html
    location /genies/ {
        alias /var/www/TheGenies/;
        index index.html;
        add_header Cache-Control "no-cache";
    }
# END TheGenies
